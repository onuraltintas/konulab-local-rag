# NVIDIA GB10 / ARM64 için NGC'nin CUDA 13.0 tabanlı PyTorch imajı kullanılır.
# Bu imajı çekmek için önce: docker login nvcr.io
ARG GPU_BASE_IMAGE=nvcr.io/nvidia/pytorch:25.10-py3
FROM ${GPU_BASE_IMAGE}

WORKDIR /app

# Docling'in tablo modeli OpenCV kullanır. NGC'nin temel GPU imajında bu
# başsız görüntüleme bağımlılıkları bulunmadığından, PDF dönüşümü ilk tabloda
# ``libxcb.so.1`` hatası verirdi. GUI kurmadan yalnızca gerekli çalışma zamanı
# kitaplıklarını ekliyoruz.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libglib2.0-0 \
        libgl1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libxkbcommon0 \
        libxcb1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.gpu.txt ./
# NGC imajının test edilmiş PyTorch/CUDA paketlerini değiştirmeden uygulama
# bağımlılıklarını ekler. 25.03+ imajlarındaki NVIDIA constraints dosyası korunur.
RUN python -m pip install --no-cache-dir \
    --constraint /etc/pip/constraint.txt \
    -r requirements.gpu.txt

COPY app ./app
COPY evals ./evals
COPY scripts ./scripts

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/models/huggingface

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
